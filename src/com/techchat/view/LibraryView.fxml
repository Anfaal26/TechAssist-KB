<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.techchat.controller.LibraryViewController">
   <children>
      <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Document Library">
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </Label>
      
      <HBox spacing="10.0">
         <children>
            <Button fx:id="uploadButton" mnemonicParsing="false" onAction="#handleUploadDocument" text="+ Upload Document" />
            <TextField promptText="Filter documents..." HBox.hgrow="ALWAYS" />
         </children>
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" right="20.0" />
         </VBox.margin>
      </HBox>
      
      <TableView fx:id="documentsTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="nameColumn" prefWidth="350.0" minWidth="200.0" text="DOCUMENT NAME" />
          <TableColumn fx:id="typeColumn" prefWidth="100.0" minWidth="80.0" text="TYPE" />
          <TableColumn fx:id="tagsColumn" prefWidth="200.0" minWidth="120.0" text="TAGS" />
          <TableColumn fx:id="dateColumn" prefWidth="150.0" minWidth="120.0" text="DATE ADDED" />
          <TableColumn fx:id="actionsColumn" prefWidth="120.0" minWidth="100.0" text="ACTIONS" />
        </columns>
        <VBox.margin>
           <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
        </VBox.margin>
      </TableView>
   </children>
</VBox>
