<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.techchat.controller.ChatHistoryViewController">
   <top>
      <VBox spacing="10.0">
         <children>
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Chat History">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </Label>
            
            <!-- Search and filter controls -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <TextField fx:id="searchField" promptText="Search conversations..." HBox.hgrow="ALWAYS" />
                  <Button fx:id="searchButton" mnemonicParsing="false" onAction="#handleSearch" text="🔍 Search" />
                  <CheckBox fx:id="bookmarkedOnlyCheckbox" mnemonicParsing="false" onAction="#handleFilterChange" text="⭐ Bookmarked Only" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
               </padding>
            </HBox>
            
            <!-- Stats label -->
            <Label fx:id="statsLabel" text="Total conversations: 0">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" right="10.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
   </top>
   
   <center>
      <!-- Conversation list -->
      <ListView fx:id="conversationsList" VBox.vgrow="ALWAYS">
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </BorderPane.margin>
      </ListView>
   </center>
   
   <bottom>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="viewButton" mnemonicParsing="false" onAction="#handleViewConversation" text="👁️ View Full Chat" styleClass="button-primary"/>
            <Button fx:id="exportButton" mnemonicParsing="false" onAction="#handleExportConversation" text="📥 Export Selected" styleClass="button-info"/>
            <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#handleDeleteConversation" text="🗑️ Delete" styleClass="button-danger"/>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
