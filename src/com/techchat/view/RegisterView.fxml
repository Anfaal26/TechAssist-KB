               <Circle radius="2.5" opacity="0.5" fill="#58a6ff" translateX="-220" translateY="-30"/>
               <Circle radius="2.5" opacity="0.5" fill="#58a6ff" translateX="-170" translateY="-35"/>
               <Circle radius="2.5" opacity="0.5" fill="#58a6ff" translateX="-120" translateY="-30"/>
               <Circle radius="2.5" opacity="0.5" fill="#58a6ff" translateX="-70" translateY="-18"/>
               <Circle radius="2.5" opacity="0.5" fill="#58a6ff" translateX="-20" translateY="0"/>
               <Circle radius="2.5" opacity="0.5" fill="#58a6ff" translateX="30" translateY="18"/>
               <Circle radius="2.5" opacity="0.5" fill="#58a6ff" translateX="80" translateY="30"/>
               <Circle radius="2.5" opacity="0.5" fill="#58a6ff" translateX="130" translateY="35"/>
               <Circle radius="2.5" opacity="0.5" fill="#58a6ff" translateX="180" translateY="30"/>
               <Circle radius="2.5" opacity="0.5" fill="#58a6ff" translateX="230" translateY="18"/>
               <Circle radius="2.5" opacity="0.5" fill="#58a6ff" translateX="280" translateY="0"/>
            </Group>
            
            <!-- INTERMEDIATE CONNECTING DOTS - Fill gaps between wave groups for smooth flow -->
            <Group fx:id="intermediateWaveGroup1" translateY="-100">
               <!-- Intermediate dots between wave 1 and 2 (smaller dots for connection) -->
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="-290" translateY="5"/>
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="-240" translateY="-2"/>
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="-190" translateY="-8"/>
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="-140" translateY="-10"/>
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="-90" translateY="-8"/>
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="-40" translateY="-2"/>
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="10" translateY="5"/>
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="60" translateY="8"/>
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="110" translateY="10"/>
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="160" translateY="8"/>
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="210" translateY="5"/>
               <Circle radius="1.2" opacity="0.5" fill="#4a9bd8" translateX="260" translateY="0"/>
            </Group>
            
            <Group fx:id="intermediateWaveGroup2" translateY="25">
               <!-- Intermediate dots between wave 2 and 3 (smaller dots) -->
               <Circle radius="1.5" opacity="0.45" fill="#3d8fc7" translateX="-270" translateY="8"/>
               <Circle radius="1.5" opacity="0.45" fill="#3d8fc7" translateX="-220" translateY="15"/>
               <Circle radius="1.5" opacity="0.45" fill="#3d8fc7" translateX="-170" translateY="18"/>
               <Circle radius="1.5" opacity="0.45" fill="#3d8fc7" translateX="-120" translateY="15"/>
               <Circle radius="1.5" opacity="0.45" fill="#3d8fc7" translateX="-70" translateY="8"/>
               <Circle radius="1.5" opacity="0.45" fill="#3d8fc7" translateX="-20" translateY="0"/>
               <Circle radius="1.5" opacity="0.45" fill="#3d8fc7" translateX="30" translateY="-8"/>
               <Circle radius="1.5" opacity="0.45" fill="#3d8fc7" translateX="80" translateY="-15"/>
              <Circle radius="1.5" opacity="0.45" fill="#3d8fc7" translateX="130" translateY="-18"/>
               <Circle radius="1.5" opacity="0.45" fill="#3d8fc7" translateX="180" translateY="-15"/>
               <Circle radius="1.5" opacity="0.45" fill="#3d8fc7" translateX="230" translateY="-8"/>
            </Group>
            
            <Group fx:id="intermediateWaveGroup3" translateY="-25">
               <!-- Extra intermediate dots for ultimate smoothness (tiny dots) -->
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="-305" translateY="-8"/>
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="-255" translateY="-12"/>
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="-205" translateY="-14"/>
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="-155" translateY="-12"/>
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="-105" translateY="-8"/>
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="-55" translateY="0"/>
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="-5" translateY="8"/>
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="45" translateY="12"/>
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="95" translateY="14"/>
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="145" translateY="12"/>
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="195" translateY="8"/>
               <Circle radius="1.0" opacity="0.4" fill="#5099d5" translateX="245" translateY="0"/>
            </Group>
         </children>
      </StackPane>
      
      <!-- Main registration card with blue glow -->
      <VBox alignment="CENTER" spacing="12.0" maxWidth="380.0" maxHeight="550.0" 
            style="-fx-background-color: #1c2128 !important; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(88, 166, 255, 0.25), 30, 0.6, 0, 0); -fx-padding: 35; -fx-border-color: rgba(88, 166, 255, 0.4); -fx-border-width: 1px; -fx-border-radius: 20;">
         <children>
            <!-- Logo/Title Section -->
            <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: transparent;">
               <children>

                  <Label text="TechAssist" 
                         style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e6edf3; -fx-background-color: transparent;">
                     <VBox.margin>
                        <Insets bottom="3.0" />
                     </VBox.margin>
                  </Label>
                  
                  <Label text="Create New Account" 
                         style="-fx-font-size: 14px; -fx-text-fill: #7d8590; -fx-background-color: transparent;">
                     <VBox.margin>
                        <Insets bottom="12.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
            
            <!-- Input Fields -->
            <VBox spacing="10.0" alignment="CENTER" style="-fx-background-color: transparent;">
               <children>
                  <VBox spacing="5.0" style="-fx-background-color: transparent;">
                     <children>
                        <Label text="Username" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e6edf3; -fx-background-color: transparent;" />
                        <TextField fx:id="usernameField" promptText="Choose a username (min 3 characters)"
                                   style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-prompt-text-fill: #7d8590; -fx-background-radius: 10; -fx-border-color: #30363d; -fx-border-width: 1px; -fx-border-radius: 10; -fx-padding: 10; -fx-font-size: 13px; -fx-pref-width: 280;"/>
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0" style="-fx-background-color: transparent;">
                     <children>
                        <Label text="Password" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e6edf3; -fx-background-color: transparent;" />
                        <PasswordField fx:id="passwordField" promptText="Enter password (min 6 characters)"
                                       style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-prompt-text-fill: #7d8590; -fx-background-radius: 10; -fx-border-color: #30363d; -fx-border-width: 1px; -fx-border-radius: 10; -fx-padding: 10; -fx-font-size: 13px; -fx-pref-width: 280;"/>
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0" style="-fx-background-color: transparent;">
                     <children>
                        <Label text="Confirm Password" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e6edf3; -fx-background-color: transparent;" />
                        <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password"
                                       style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-prompt-text-fill: #7d8590; -fx-background-radius: 10; -fx-border-color: #30363d; -fx-border-width: 1px; -fx-border-radius: 10; -fx-padding: 10; -fx-font-size: 13px; -fx-pref-width: 280;"/>
                     </children>
                  </VBox>
                  
                  <Label fx:id="errorLabel" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: transparent;">
                     <VBox.margin>
                        <Insets top="3.0" />
                     </VBox.margin>
                  </Label>
                  
                  <Label fx:id="successLabel" text="" style="-fx-text-fill: #27ae60; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: transparent;">
                     <VBox.margin>
                        <Insets top="3.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
            
            <!-- Buttons -->
            <VBox spacing="8.0" alignment="CENTER" style="-fx-background-color: transparent;">
               <children>
                  <Button text="Register" onAction="#handleRegister" prefWidth="280.0" prefHeight="40.0"
                          style="-fx-background-color: #238636; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: rgba(240, 246, 252, 0.1); -fx-border-width: 1px;">
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </Button>
                  
                  <Button text="← Back to Login" onAction="#handleBackToLogin" prefWidth="280.0" prefHeight="40.0"
                          style="-fx-background-color: #161b22; -fx-text-fill: #e6edf3; -fx-border-color: #30363d; -fx-border-width: 1px; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
