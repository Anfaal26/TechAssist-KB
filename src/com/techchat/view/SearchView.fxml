<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.techchat.controller.SearchViewController">
   <children>
      <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Search">
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </Label>
      
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="searchField" promptText="Search documentation, guides, and technical resources..." HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleSearch" text="Search" />
         </children>
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" right="20.0" />
         </VBox.margin>
      </HBox>
      
      <HBox spacing="5.0">
         <children>
            <Button mnemonicParsing="false" text="All Results" />
            <Button mnemonicParsing="false" text="Guides" />
            <Button mnemonicParsing="false" text="API Docs" />
            <Button mnemonicParsing="false" text="Troubleshooting" />
            <Button mnemonicParsing="false" text="Security" />
         </children>
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" right="20.0" />
         </VBox.margin>
      </HBox>
      
      <Label fx:id="resultCount" text="0 results found">
         <VBox.margin>
            <Insets bottom="5.0" left="20.0" />
         </VBox.margin>
      </Label>
      
      <ListView fx:id="resultsList" VBox.vgrow="ALWAYS">
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
         </VBox.margin>
      </ListView>
   </children>
</VBox>
