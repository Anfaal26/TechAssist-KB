<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.techchat.controller.SettingsViewController">
   <children>
      <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Settings">
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </Label>
      
      <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="General Settings">
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" />
         </VBox.margin>
      </Label>
      
      <GridPane hgap="10.0" vgap="10.0">
        <children>
            <Label text="Application Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="appNameField" text="TechAssist Knowledge Base System" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300.0" />
            
            <Label text="Theme:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="themeComboBox" promptText="Light" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300.0" />
            
            <Label text="Language:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <ComboBox fx:id="languageComboBox" promptText="English" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="300.0" />
        </children>
        <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" />
        </VBox.margin>
      </GridPane>
      
      <!-- AI Model Settings Section (Admin Only) -->
      <VBox fx:id="aiSettingsSection">
         <children>
            <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="AI Model Settings">
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" />
               </VBox.margin>
            </Label>
            
            <GridPane hgap="10.0" vgap="10.0">
              <children>
                  <Label text="API Key:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <PasswordField fx:id="apiKeyField" promptText="Enter API key" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  
                  <Label text="AI Model:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <ComboBox fx:id="modelComboBox" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Temperature:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <Slider fx:id="temperatureSlider" max="1.0" min="0.0" value="0.7" prefWidth="300.0" showTickLabels="true" showTickMarks="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <Label text="Max Tokens:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <Spinner fx:id="maxTokensSpinner" editable="true" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
              </children>
              <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" />
              </VBox.margin>
            </GridPane>
         </children>
      </VBox>
      
      <!-- RAG Search Settings Section -->
      <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="RAG Search Settings">
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" top="10.0" />
         </VBox.margin>
      </Label>
      
      <GridPane hgap="10.0" vgap="10.0">
        <children>
            <Label text="Search Sensitivity:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Slider fx:id="similarityThresholdSlider" max="1.0" min="0.0" value="0.5" prefWidth="250.0" 
                    showTickLabels="true" showTickMarks="true" majorTickUnit="0.25" minorTickCount="4"
                    GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label fx:id="thresholdValueLabel" text="0.50" style="-fx-font-weight: bold;" 
                    GridPane.columnIndex="2" GridPane.rowIndex="0" />
            
            <Label text="" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label text="Controls how similar documents must be to appear in results.&#10;&#8226; Lower (0.3-0.4): More results, some may be less relevant&#10;&#8226; Medium (0.5): Balanced (recommended)&#10;&#8226; Higher (0.6-0.8): Fewer results, only very similar documents" 
                    style="-fx-font-size: 11px; -fx-text-fill: #666;" wrapText="true" prefWidth="400.0"
                    GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2" />
        </children>
        <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" />
        </VBox.margin>
      </GridPane>
      
      <Label fx:id="statusLabel" text="" style="-fx-text-fill: green; -fx-font-weight: bold;">
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" />
         </VBox.margin>
      </Label>
      
      <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSaveSettings" styleClass="button-success" text="Save Settings">
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>
