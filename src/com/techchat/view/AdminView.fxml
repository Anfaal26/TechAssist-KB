<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.techchat.controller.AdminViewController">
   <padding>
      <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
   </padding>
   <children>
      <Label text="Admin Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
      
      <TabPane>
         <tabs>
            <!-- Activity Log Tab -->
            <Tab text="Activity Log" closable="false">
               <VBox spacing="15.0">
                  <padding>
                     <Insets top="15.0" />
                  </padding>
                  <children>
                     <Label text="User Activity Monitor" styleClass="section-subheader"/>
                     
                     <HBox spacing="10.0">
                        <children>
                           <Button text="Refresh" onAction="#handleRefreshLogs" styleClass="button-primary"/>
                           <Label fx:id="statsLabel" text="Total Logs: 0" style="-fx-font-size: 12px;"/>
                        </children>
                     </HBox>
                     
                      <TableView fx:id="activityTable" prefHeight="400.0" VBox.vgrow="ALWAYS">
                         <columns>
                            <TableColumn fx:id="timestampColumn" text="Timestamp" prefWidth="180.0" minWidth="150.0"/>
                            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="120.0" minWidth="100.0"/>
                            <TableColumn fx:id="actionColumn" text="Action" prefWidth="150.0" minWidth="120.0"/>
                            <TableColumn fx:id="detailsColumn" text="Details" prefWidth="400.0" minWidth="200.0"/>
                         </columns>
                      </TableView>
                     
                     <Label text="Activity Types: LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, REGISTRATION" 
                            style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                  </children>
               </VBox>
            </Tab>
            
            <!-- User Management Tab -->
            <Tab text="User Management" closable="false">
               <VBox spacing="15.0">
                  <padding>
                     <Insets top="15.0" />
                  </padding>
                  <children>
                     <Label text="Registered Users" styleClass="section-subheader"/>
                     
                     <HBox spacing="10.0">
                        <children>
                           <Button text="Refresh" onAction="#handleRefreshUsers" styleClass="button-success"/>
                           <Label fx:id="userStatsLabel" text="Total Users: 0" style="-fx-font-size: 12px;"/>
                        </children>
                     </HBox>
                     
                     <TableView fx:id="userTable" prefHeight="400.0" VBox.vgrow="ALWAYS">
                        <columns>
                           <TableColumn fx:id="userIdColumn" text="User ID" prefWidth="80.0" minWidth="70.0"/>
                           <TableColumn fx:id="usernameUserColumn" text="Username" prefWidth="140.0" minWidth="100.0"/>
                           <TableColumn fx:id="passwordColumn" text="Password" prefWidth="140.0" minWidth="100.0"/>
                           <TableColumn fx:id="nameColumn" text="Name" prefWidth="180.0" minWidth="120.0"/>
                           <TableColumn fx:id="roleColumn" text="Role" prefWidth="120.0" minWidth="100.0"/>
                           <TableColumn fx:id="userActionsColumn" text="ACTIONS" prefWidth="150.0" minWidth="120.0"/>
                        </columns>
                     </TableView>
                  </children>
               </VBox>
            </Tab>
         </tabs>
      </TabPane>
   </children>
</VBox>
