               <Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/>
               <Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/>
               <Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/>
               <Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/>
               <Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/><Circle radius="0.55" opacity="0.22" fill="#78b5e8"/>
