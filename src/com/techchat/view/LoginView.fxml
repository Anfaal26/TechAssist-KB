          </children>
       </StackPane>

       <!-- Main content container -->
      <VBox fx:id="loginCard" alignment="CENTER" spacing="15.0" maxWidth="380.0" maxHeight="460.0" 
            style="-fx-background-color: #1c2128 !important; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(88, 166, 255, 0.25), 30, 0.6, 0, 0); -fx-padding: 35; -fx-border-color: rgba(88, 166, 255, 0.4); -fx-border-width: 1px; -fx-border-radius: 20;">
         <children>
            <!-- Logo/Title Section -->
            <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: transparent;">
               <children>

                  <Label fx:id="titleLabel" text="TechAssist" 
                         style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e6edf3; -fx-background-color: transparent;">
                     <VBox.margin>
                        <Insets bottom="3.0" />
                     </VBox.margin>
                  </Label>
                  
                  <Label text="Welcome back! Please login to your account" 
                         style="-fx-font-size: 12px; -fx-text-fill: #7d8590; -fx-background-color: transparent;">
                     <VBox.margin>
                        <Insets bottom="15.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
            
            <!-- Input Fields -->
            <VBox spacing="12.0" alignment="CENTER" style="-fx-background-color: transparent;">
               <children>
                  <VBox spacing="6.0" style="-fx-background-color: transparent;">
                     <children>
                        <Label text="Username" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e6edf3; -fx-background-color: transparent;" />
                        <TextField fx:id="usernameField" promptText="Enter your username"
                                   style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-prompt-text-fill: #7d8590; -fx-background-radius: 10; -fx-border-color: #30363d; -fx-border-width: 1px; -fx-border-radius: 10; -fx-padding: 10; -fx-font-size: 13px; -fx-pref-width: 280;"
                                   onMouseEntered="#handleFieldHover" onMouseExited="#handleFieldExit"/>
                     </children>
                  </VBox>
                  
                  <VBox spacing="6.0" style="-fx-background-color: transparent;">
                     <children>
                        <Label text="Password" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e6edf3; -fx-background-color: transparent;" />
                        <PasswordField fx:id="passwordField" promptText="Enter your password"
                                       style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-prompt-text-fill: #7d8590; -fx-background-radius: 10; -fx-border-color: #30363d; -fx-border-width: 1px; -fx-border-radius: 10; -fx-padding: 10; -fx-font-size: 13px; -fx-pref-width: 280;"
                                       onMouseEntered="#handleFieldHover" onMouseExited="#handleFieldExit"/>
                     </children>
                  </VBox>
                  
                  <Label fx:id="errorLabel" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: transparent;">
                     <VBox.margin>
                        <Insets top="3.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
            
            <!-- Buttons -->
            <VBox spacing="10.0" alignment="CENTER" style="-fx-background-color: transparent;">
               <children>
                  <Button fx:id="loginButton" text="Login" onAction="#handleLogin" prefWidth="280.0" prefHeight="40.0"
                          style="-fx-background-color: #238636; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: rgba(240, 246, 252, 0.1); -fx-border-width: 1px;"
                          onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonExit">
                     <VBox.margin>
                        <Insets top="8.0" />
                     </VBox.margin>
                  </Button>
                  
                  <Button text="Create New Account" onAction="#handleRegister" prefWidth="280.0" prefHeight="40.0"
                          style="-fx-background-color: #161b22; -fx-text-fill: #e6edf3; -fx-border-color: #30363d; -fx-border-width: 1px; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"
                          onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonExit"/>
               </children>
            </VBox>
            

         </children>
      </VBox>
   </children>
</StackPane>
