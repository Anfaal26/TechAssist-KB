<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.techchat.controller.ChatViewController">
   <center>
      <ScrollPane fx:id="chatScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS">
         <content>
            <VBox fx:id="messageContainer" spacing="10.0">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <VBox spacing="10.0">
         <children>
            <!-- Top toolbar with Export and Bookmark buttons -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="bookmarkButton" mnemonicParsing="false" onAction="#handleBookmark" text="⭐ Bookmark" styleClass="button-warning"/>
                  <Button fx:id="exportButton" mnemonicParsing="false" onAction="#handleExport" text="📥 Export Chat" styleClass="button-info"/>
               </children>
               <padding>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
            
            <!-- Input controls -->
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="imageButton" mnemonicParsing="false" onAction="#handleImageUpload" text="📷 Image" styleClass="button-secondary"/>
                  <TextField fx:id="userInput" onAction="#handleSendAction" promptText="Type your question..." HBox.hgrow="ALWAYS" />
                  <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleSendAction" text="Send" styleClass="button-primary" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </bottom>
   <right>
      <VBox prefWidth="250.0" spacing="5.0" style="-fx-border-color: #cccccc; -fx-border-width: 0 0 0 1;">
         <children>
            <Label styleClass="section-header" text="Retrieved Documents">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </Label>
            <Label styleClass="section-subheader" text="Sources used to generate response:">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </VBox.margin>
            </Label>
            <ListView fx:id="sourcesList" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </VBox.margin>
            </ListView>
         </children>
      </VBox>
   </right>
</BorderPane>
