       <!-- Main content - Centered TechAssist branding with text links -->
      <VBox alignment="CENTER" spacing="0" style="-fx-background-color: transparent;">
         <children>
            <!-- Large TechAssist Title with Metallic Effect -->
            <Label fx:id="titleLabel" text="TechAssist" 
                   style="-fx-font-family: 'Ethnocentric', 'Orbitron', 'Bahnschrift', 'Century Gothic', sans-serif; -fx-font-size: 96px; -fx-font-weight: 900; -fx-background-color: transparent; -fx-letter-spacing: -0.1em;">
               <textFill>
                  <LinearGradient startX="0" startY="0" endX="0" endY="1">
                     <stops>
                        <Stop offset="0.0" color="#ffffff"/>
                        <Stop offset="0.3" color="#e0e0e0"/>
                        <Stop offset="0.5" color="#c0c0c0"/>
                        <Stop offset="0.7" color="#a8a8a8"/>
                        <Stop offset="1.0" color="#888888"/>
                     </stops>
                  </LinearGradient>
               </textFill>
               <effect>
                  <Blend mode="MULTIPLY">
                     <topInput>
                        <DropShadow color="#1f6feb" radius="15" spread="0.4" blurType="GAUSSIAN"/>
                     </topInput>
                     <bottomInput>
                        <InnerShadow color="#000000" radius="3" choke="0.5" offsetY="-2"/>
                     </bottomInput>
                  </Blend>
               </effect>
            </Label>
            
                         
             <!-- Slogan with same metallic effect and glow -->
             <Label fx:id="sloganLabel" text="Ask, Solve, Done" translateY="-20" 
                    style="-fx-text-fill: white; -fx-font-family: 'Ethnocentric', 'Orbitron', 'Bahnschrift', 'Century Gothic', sans-serif; -fx-font-size: 28px; -fx-font-weight: bold; -fx-font-style: italic; -fx-background-color: transparent; -fx-letter-spacing: 0.05em;">
                <effect>
                   <Blend mode="MULTIPLY">
                      <topInput>
                         <DropShadow color="#58a6ff" radius="15" spread="0.3" blurType="GAUSSIAN"/>
                      </topInput>
                      <bottomInput>
                         <InnerShadow color="#000000" radius="3" choke="0.5" offsetY="-2"/>
                      </bottomInput>
                   </Blend>
                </effect>
             </Label>
<!-- Simple text links for login and register -->
            <javafx.scene.layout.HBox alignment="CENTER" spacing="30.0" style="-fx-background-color: transparent;">
               <children>
                  <Label fx:id="loginLink" text="login" onMouseClicked="#handleLogin"
                         style="-fx-font-size: 18px; -fx-text-fill: #ffffff; -fx-underline: true; -fx-cursor: hand; -fx-background-color: transparent;"
                         onMouseEntered="#handleLinkHover" onMouseExited="#handleLinkExit"/>
                  
                  <Label fx:id="registerLink" text="register" onMouseClicked="#handleRegister"
                         style="-fx-font-size: 18px; -fx-text-fill: #ffffff; -fx-underline: true; -fx-cursor: hand; -fx-background-color: transparent;"
                         onMouseEntered="#handleLinkHover" onMouseExited="#handleLinkExit"/>
               </children>
            </javafx.scene.layout.HBox>
         </children>
