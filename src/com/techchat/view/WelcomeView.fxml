            <!-- Modal Overlay (semi-transparent background) -->
      <StackPane fx:id="modalOverlay" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.7);" onMouseClicked="#closeModals">
      </StackPane>
      <!-- Login Modal Card -->
      <VBox fx:id="loginModal" visible="false" alignment="CENTER" spacing="15.0" maxWidth="380.0" maxHeight="460.0" 
            style="-fx-background-color: #1c2128 !important; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(88, 166, 255, 0.25), 30, 0.6, 0, 0); -fx-padding: 35; -fx-border-color: rgba(88, 166, 255, 0.4); -fx-border-width: 1px; -fx-border-radius: 20;">
         <children>
            <Label text="✕" onMouseClicked="#closeModals" style="-fx-font-size: 20px; -fx-text-fill: #7d8590; -fx-cursor: hand;"/>
            <Label text="TechAssist" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e6edf3;"/>
            <Label text="Welcome back! Please login to your account" style="-fx-font-size: 12px; -fx-text-fill: #7d8590;"/>
            
            <TextField fx:id="loginUsernameField" promptText="Enter your username" style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-pref-width: 280;"/>
            <PasswordField fx:id="loginPasswordField" promptText="Enter your password" style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-pref-width: 280;"/>
            <Label fx:id="loginErrorLabel" text="" style="-fx-text-fill: #e74c3c;"/>
            
            <Button fx:id="loginButton" text="Login" onAction="#handleLoginSubmit" prefWidth="280.0" prefHeight="40.0" style="-fx-background-color: #238636; -fx-text-fill: white;"/>
            <Label text="Don't have an account? Register" onMouseClicked="#switchToRegister" style="-fx-text-fill: #58a6ff; -fx-cursor: hand; -fx-underline: true;"/>
         </children>
      </VBox>
      <!-- Register Modal Card -->
      <VBox fx:id="registerModal" visible="false" alignment="CENTER" spacing="12.0" maxWidth="380.0" maxHeight="550.0" 
            style="-fx-background-color: #1c2128; -fx-background-radius: 20; -fx-padding: 35;">
         <children>
            <Label text="✕" onMouseClicked="#closeModals" style="-fx-font-size: 20px; -fx-text-fill: #7d8590; -fx-cursor: hand;"/>
            <Label text="TechAssist" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e6edf3;"/>
            <Label text="Create New Account" style="-fx-font-size: 14px; -fx-text-fill: #7d8590;"/>
            
            <TextField fx:id="registerUsernameField" promptText="Choose a username" style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-pref-width: 280;"/>
            <PasswordField fx:id="registerPasswordField" promptText="Enter password" style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-pref-width: 280;"/>
            <PasswordField fx:id="registerConfirmPasswordField" promptText="Re-enter password" style="-fx-background-color: #0d1117; -fx-text-fill: #e6edf3; -fx-pref-width: 280;"/>
            <Label fx:id="registerErrorLabel" text="" style="-fx-text-fill: #e74c3c;"/>
            <Label fx:id="registerSuccessLabel" text="" style="-fx-text-fill: #27ae60;"/>
            
            <Button text="Register" onAction="#handleRegisterSubmit" prefWidth="280.0" prefHeight="40.0" style="-fx-background-color: #238636; -fx-text-fill: white;"/>
            <Label text="Already have an account? Login" onMouseClicked="#switchToLogin" style="-fx-text-fill: #58a6ff; -fx-cursor: hand; -fx-underline: true;"/>
         </children>
      </VBox>
   </children>
</StackPane>
